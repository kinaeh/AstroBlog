---
// Se utiliza import.meta.glob en lugar de Astro.glob
const postsMap = import.meta.glob('./posts/*.md', { eager: true });
const allPosts = Object.values(postsMap);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Mi Blog</title>
  </head>
  <body>
    <h1>Mi Blog</h1>

    <nav>
      <a href="/">Inicio</a> | 
      <a href="/blog">Ver el Blog</a>
    </nav>

    <ul>
      {allPosts.map((post: any) => (
        <li>
          <a href={post.url}>{post.frontmatter.title}</a>
        </li>
      ))}
    </ul>
  </body>
</html>